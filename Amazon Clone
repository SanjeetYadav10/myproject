<!DOCTYPE html>
<html>
<head>
    <title>Mini Amazon Clone</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, sans-serif;
        }

        body{
            background:lightgray;
        }

        header{
            background:black;
            color:white;
            padding:15px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }

        .logo{
            font-size:28px;
            font-weight:bold;
        }

        .search input{
            padding:8px;
            width:300px;
        }

        .search button{
            padding:8px;
            cursor:pointer;
        }

        .cart{
            font-size:20px;
        }

        h2{
            text-align:center;
            margin:20px;
        }

        .products{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
            gap:20px;
            padding:20px;
        }

        .card{
            background:white;
            padding:15px;
            border-radius:10px;
            text-align:center;
            box-shadow:0 0 5px gray;
        }

        .card img{
            width:100%;
            height:180px;
            object-fit:cover;
            border-radius:5px;
        }

        .card h3{
            margin:10px 0;
        }

        .price{
            color:green;
            font-size:20px;
            margin-bottom:10px;
        }

        button{
            background:orange;
            border:none;
            padding:10px 15px;
            cursor:pointer;
            border-radius:5px;
        }

        button:hover{
            background:gold;
        }
    </style>
</head>

<body>

<header>
    <div class="logo">amazon</div>

    <div class="search">
        <input type="text" placeholder="Search Products">
        <button>Search</button>
    </div>

    <div class="cart">
        Cart: <span id="count">0</span>
    </div>
</header>

<h2>Today's Deals</h2>

<div class="products">

    <div class="card">
        <img src="https://images.pexels.com/photos/18105/pexels-photo.jpg">
        <h3>laptop</h3>
        <div class="price">₹45000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/699122/pexels-photo-699122.jpeg" alt="Mobile">
        <h3>Mobile</h3>
        <div class="price">₹15000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/3394650/pexels-photo-3394650.jpeg" alt="Headphones">
        <h3>Headphones</h3>
        <div class="price">₹2000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/437037/pexels-photo-437037.jpeg" alt="Smart Watch">
        <h3>Smart Watch</h3>
        <div class="price">₹3000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/1772123/pexels-photo-1772123.jpeg" alt="Keyboard">
        <h3>Keyboard</h3>
        <div class="price">₹800</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg" alt="Mouse">
        <h3>Mouse</h3>
        <div class="price">₹500</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/90946/pexels-photo-90946.jpeg" alt="Camera">
        <h3>Camera</h3>
        <div class="price">₹25000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/1649771/pexels-photo-1649771.jpeg" alt="Speaker">
        <h3>Speaker</h3>
        <div class="price">₹3500</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/159711/books-bookstore-book-reading-159711.jpeg" alt="Printer">
        <h3>Printer</h3>
        <div class="price">₹7000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

    <div class="card">
<img src="https://images.pexels.com/photos/1334597/pexels-photo-1334597.jpeg" alt="Tablet">        <h3>Tablet</h3>
        <div class="price">₹12000</div>
        <button onclick="addCart()">Add to Cart</button>
    </div>

</div>

<script>
    let cartCount = 0;

    function addCart()
    {
        cartCount++;
        document.getElementById("count").innerHTML = cartCount;
    }
</script>

</body>
</html>
