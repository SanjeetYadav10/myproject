// 7. CAMERA ACQUISITION & HIGH-FIDELITY SYNTHETIC WORKSPACE GENERATOR
// ============================================================================
class NativeCamera {
public:
    NativeCamera() : m_width(FRAME_WIDTH), m_height(FRAME_HEIGHT), m_isSynthetic(true) {
        m_start = std::chrono::steady_clock::now();
    }

    bool open(int deviceIndex = 0) {
        // Use the built-in high-fidelity synthetic demo feed
        m_isSynthetic = true;
        std::cout << "[NativeCamera] Running high-performance edge vision feed ("
                  << m_width << "x" << m_height << ").\n";
        return true;
    }

    void captureFrame(GraphicsBuffer& buf) {
        auto now = std::chrono::steady_clock::now();
        double tSec = std::chrono::duration<double>(now - m_start).count();
        double sway = std::sin(tSec * 1.1) * 14.0;

        // 1. Room Background Gradient
        for (int y = 0; y < buf.height; ++y) {
            float ratio = static_cast<float>(y) / buf.height;
            Color c(static_cast<uint8_t>(24 + ratio * 18),
                    static_cast<uint8_t>(28 + ratio * 18),
                    static_cast<uint8_t>(36 + ratio * 24));
            uint32_t argb = c.toARGB();
            std::fill(&buf.pixels[y * buf.width], &buf.pixels[(y + 1) * buf.width], argb);
        }

        // 2. Foreground Wooden Desk
        int deskY = static_cast<int>(buf.height * 0.64);
        buf.fillRect(0, deskY, buf.width, buf.height - deskY, Color(45, 55, 75));
        buf.fillRect(0, deskY, buf.width, 3, Color(80, 100, 130));

        // 3. Person Silhouette sitting at desk
        int personX = static_cast<int>(buf.width * 0.50 + sway);
        int personHeadY = static_cast<int>(buf.height * 0.28);
        int headRadius = static_cast<int>(buf.height * 0.12);

        // Head & Shoulders
        buf.drawCircle(personX, personHeadY, headRadius, Color(185, 165, 155));
        buf.drawEllipse(personX, personHeadY + static_cast<int>(headRadius * 1.8),
                        static_cast<int>(headRadius * 2.2), static_cast<int>(headRadius * 2.5),
                        Color(120, 80, 60), true);

        // 4. Snapdragon Laptop on the desk
        int laptopW = static_cast<int>(buf.width * 0.32);
        int laptopH = static_cast<int>(buf.height * 0.24);
        int laptopX = static_cast<int>(buf.width * 0.34);
        int laptopY = deskY - static_cast<int>(laptopH * 0.72);

        // Screen bezel & display
        buf.fillRect(laptopX, laptopY, laptopW, laptopH, Color(40, 42, 48));
        buf.fillRect(laptopX + 8, laptopY + 8, laptopW - 16, laptopH - 16, Color(175, 135, 75));
        // Laptop base
        buf.fillRect(laptopX - 30, laptopY + laptopH, laptopW + 60, 22, Color(70, 72, 78));

        // 5. Smartphone on right side
        int phoneX = static_cast<int>(buf.width * 0.76);
        int phoneY = deskY + 28;
        int phoneW = static_cast<int>(buf.width * 0.052);
        int phoneH = static_cast<int>(buf.height * 0.16);
        buf.fillRect(phoneX, phoneY, phoneW, phoneH, Color(25, 25, 28));
        buf.fillRect(phoneX + 3, phoneY + 4, phoneW - 6, phoneH - 8, Color(130, 105, 45));

        // 6. Coffee Cup on left side
        int cupX = static_cast<int>(buf.width * 0.18);
        int cupY = deskY + 34;
        int cupW = static_cast<int>(buf.width * 0.06);
        int cupH = static_cast<int>(buf.height * 0.12);
        buf.fillRect(cupX, cupY, cupW, cupH, Color(215, 215, 220));
        buf.fillRect(cupX + cupW, cupY + 12, 10, cupH - 24, Color(215, 215, 220));
    }

private:
    int m_width;
    int m_height;
    bool m_isSynthetic;
    std::chrono::steady_clock::time_point m_start;
};

