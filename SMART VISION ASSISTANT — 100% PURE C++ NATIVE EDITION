        int pillY = 62;
        buf.fillAlphaRect(pillX, pillY, pillW, pillH, Color(16, 22, 32), 0.90f);
        buf.drawRect(pillX, pillY, pillW, pillH, Color(0, 200, 255), 1);
        buf.drawCircle(pillX + 22, pillY + 23, 6, Color(0, 230, 255));
    }

    // 4. Hardware Telemetry Card
    int cardW = 300;
    int cardH = 205;
    int cardX = 24;
    int cardY = buf.height - cardH - 52;
    buf.fillAlphaRect(cardX, cardY, cardW, cardH, Color(15, 18, 22), 0.88f);
    buf.drawRect(cardX, cardY, cardW, cardH, Color(60, 70, 85), 1);
    buf.fillAlphaRect(cardX, cardY, cardW, 28, Color(30, 36, 45), 0.95f);

    // 5. Bottom Controls Footer
    int footerY = buf.height - 38;
    buf.fillAlphaRect(0, footerY, buf.width, 38, Color(16, 18, 22), 0.90f);
    buf.fillRect(0, footerY, buf.width, 1, Color(70, 75, 85));
    buf.drawCircle(buf.width - 290, footerY + 19, 5, Color(50, 220, 50));

    // 6. Toast Notification Banner
    if (!toastMsg.empty()) {
        int tW = 460;
        int tH = 42;
        int tX = (buf.width - tW) / 2;
        int tY = buf.height - 110;
        buf.fillAlphaRect(tX, tY, tW, tH, Color(10, 60, 25), 0.92f);
        buf.drawRect(tX, tY, tW, tH, Color(50, 220, 50), 2);
    }
}

// Windows GDI Text Overlay
void paintGdiText(HDC hdc,
                  const std::vector<Detection>& detections,
                  const SceneContext& context,
                  const NativeProfiler& profiler,
                  bool isMuted,
                  bool isPaused,
                  const std::string& toastMsg) {
    SetBkMode(hdc, TRANSPARENT);

    // Header Titles
    HFONT hFontTitle = CreateFontA(24, 0, 0, 0, FW_BOLD, FALSE, FALSE, FALSE,
                                   DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                                   CLEARTYPE_QUALITY, DEFAULT_PITCH, "Segoe UI");
    HFONT hFontSub = CreateFontA(16, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
                                 DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                                 CLEARTYPE_QUALITY, DEFAULT_PITCH, "Segoe UI");
    HFONT hFontBody = CreateFontA(17, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
                                  DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
                                  CLEARTYPE_QUALITY, DEFAULT_PITCH, "Segoe UI");

    HGDIOBJ hOldFont = SelectObject(hdc, hFontTitle);

    // Top Header
    SetTextColor(hdc, RGB(255, 255, 255));
    TextOutA(hdc, 24, 12, "SNAPDRAGON SMART VISION", 23);

    SelectObject(hdc, hFontSub);
    SetTextColor(hdc, RGB(0, 220, 255));
    TextOutA(hdc, 335, 17, "|  ON-DEVICE EDGE AI  [PURE C++ NATIVE]", 39);

    SetTextColor(hdc, RGB(200, 200, 200));
    std::string badge = "HP Snapdragon PC  -  Qualcomm X Elite";
    TextOutA(hdc, FRAME_WIDTH - 320, 16, badge.c_str(), static_cast<int>(badge.length()));

    // Scene Context Text
    if (!context.sceneTitle.empty()) {
        SelectObject(hdc, hFontBody);
        SetTextColor(hdc, RGB(255, 255, 255));
        std::string sceneText = "SCENE: " + context.sceneTitle;
        TextOutA(hdc, (FRAME_WIDTH - 540) / 2 + 40, 74, sceneText.c_str(), static_cast<int>(sceneText.length()));
    }

    // Telemetry Card Texts
    int cardX = 24;
    int cardY = FRAME_HEIGHT - 205 - 52;
    SelectObject(hdc, hFontSub);
    SetTextColor(hdc, RGB(0, 220, 255));
    TextOutA(hdc, cardX + 14, cardY + 6, "SNAPDRAGON HARDWARE TELEMETRY", 29);

    SelectObject(hdc, hFontBody);
    SetTextColor(hdc, RGB(240, 240, 240));
    std::string objStr = "Objects Detected: " + std::to_string(detections.size());
    TextOutA(hdc, cardX + 16, cardY + 38, objStr.c_str(), static_cast<int>(objStr.length()));

    SetTextColor(hdc, RGB(0, 255, 180));
    std::stringstream infSS;
    infSS << std::fixed << std::setprecision(1) << "Inference: " << profiler.getInferenceMs() << " ms";
    std::string infStr = infSS.str();
    TextOutA(hdc, cardX + 16, cardY + 66, infStr.c_str(), static_cast<int>(infStr.length()));

    SetTextColor(hdc, RGB(255, 215, 0));
    std::stringstream fpsSS;
    fpsSS << std::fixed << std::setprecision(1) << "FPS: " << profiler.getFPS();
    std::string fpsStr = fpsSS.str();
    TextOutA(hdc, cardX + 16, cardY + 94, fpsStr.c_str(), static_cast<int>(fpsStr.length()));

    SetTextColor(hdc, RGB(180, 220, 255));
    std::stringstream utilSS;
    utilSS << std::fixed << std::setprecision(0)
           << "CPU: " << profiler.getCpuLoad() << "%  |  NPU Duty: " << profiler.getNpuDuty() << "%";
    std::string utilStr = utilSS.str();
    TextOutA(hdc, cardX + 16, cardY + 122, utilStr.c_str(), static_cast<int>(utilStr.length()));

    SetTextColor(hdc, RGB(0, 200, 255));
    std::string devStr = "Device: Snapdragon NPU [DirectML]";
    TextOutA(hdc, cardX + 16, cardY + 150, devStr.c_str(), static_cast<int>(devStr.length()));

    // Bounding Box Labels
    for (const auto& d : detections) {
        SelectObject(hdc, hFontSub);
        SetTextColor(hdc, RGB(10, 10, 10));
        std::string tag = d.className + " " + std::to_string(static_cast<int>(d.confidence * 100)) + "%";
        TextOutA(hdc, d.box.x + 8, (std::max)(0, d.box.y - 21), tag.c_str(), static_cast<int>(tag.length()));
    }

    // Footer Hotkeys
    SelectObject(hdc, hFontSub);
    SetTextColor(hdc, RGB(220, 220, 220));
    std::string footer = "[S] Snapshot   [V] Voice: " + std::string(isMuted ? "MUTED" : "ON") +
                         "   [D] Describe   [T] Status   [P] " + std::string(isPaused ? "RESUME" : "PAUSE") +
                         "   [C] Clear   [ESC] Exit";
    TextOutA(hdc, 24, FRAME_HEIGHT - 28, footer.c_str(), static_cast<int>(footer.length()));

    SetTextColor(hdc, RGB(50, 220, 50));
    std::string priv = "Local Inference  |  Zero Cloud Transmission";
    TextOutA(hdc, FRAME_WIDTH - 275, FRAME_HEIGHT - 28, priv.c_str(), static_cast<int>(priv.length()));

    // Toast Message
    if (!toastMsg.empty()) {
        SetTextColor(hdc, RGB(255, 255, 255));
        SelectObject(hdc, hFontBody);
        TextOutA(hdc, (FRAME_WIDTH - 460) / 2 + 25, FRAME_HEIGHT - 100, toastMsg.c_str(), static_cast<int>(toastMsg.length()));
    }

    SelectObject(hdc, hOldFont);
    DeleteObject(hFontTitle);
    DeleteObject(hFontSub);
    DeleteObject(hFontBody);
}

// Window Procedure
LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
    switch (msg) {
        case WM_CLOSE:
            PostQuitMessage(0);
            return 0;
        case WM_ERASEBKGND:
            return 1; // Prevent flickering
        default:
            return DefWindowProcA(hWnd, msg, wParam, lParam);
    }
}

