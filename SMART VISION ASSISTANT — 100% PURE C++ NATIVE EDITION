// 3. PURE C++ SOFTWARE 2D GRAPHICS RASTERIZER (ZERO DEPENDENCY)
// ============================================================================
class GraphicsBuffer {
public:
    int width;
    int height;
    std::vector<uint32_t> pixels;

    GraphicsBuffer(int w, int h) : width(w), height(h), pixels(w * h, 0) {}

    void clear(Color c) {
        std::fill(pixels.begin(), pixels.end(), c.toARGB());
    }

    void setPixel(int x, int y, Color c) {
        if (x < 0 || x >= width || y < 0 || y >= height) return;
        pixels[y * width + x] = c.toARGB();
    }

    void blendPixel(int x, int y, Color c, float alpha) {
        if (x < 0 || x >= width || y < 0 || y >= height) return;
        uint32_t bg = pixels[y * width + x];
        uint8_t bgB = bg & 0xFF;
        uint8_t bgG = (bg >> 8) & 0xFF;
        uint8_t bgR = (bg >> 16) & 0xFF;

        uint8_t outR = static_cast<uint8_t>(c.r * alpha + bgR * (1.0f - alpha));
        uint8_t outG = static_cast<uint8_t>(c.g * alpha + bgG * (1.0f - alpha));
        uint8_t outB = static_cast<uint8_t>(c.b * alpha + bgB * (1.0f - alpha));

        pixels[y * width + x] = (0xFF << 24) | (outR << 16) | (outG << 8) | outB;
    }

    void fillRect(int x, int y, int w, int h, Color c) {
        int x0 = (std::max)(0, x);
        int y0 = (std::max)(0, y);
        int x1 = (std::min)(width, x + w);
        int y1 = (std::min)(height, y + h);
        uint32_t col = c.toARGB();

        for (int j = y0; j < y1; ++j) {
            uint32_t* row = &pixels[j * width];
            for (int i = x0; i < x1; ++i) {
                row[i] = col;
            }
        }
    }

    void fillAlphaRect(int x, int y, int w, int h, Color c, float alpha) {
        int x0 = (std::max)(0, x);
        int y0 = (std::max)(0, y);
        int x1 = (std::min)(width, x + w);
        int y1 = (std::min)(height, y + h);

        for (int j = y0; j < y1; ++j) {
            for (int i = x0; i < x1; ++i) {
                blendPixel(i, j, c, alpha);
            }
        }
    }

    void drawRect(int x, int y, int w, int h, Color c, int thickness = 2) {
        fillRect(x, y, w, thickness, c);
        fillRect(x, y + h - thickness, w, thickness, c);
        fillRect(x, y, thickness, h, c);
        fillRect(x + w - thickness, y, thickness, h, c);
    }

    void drawCornerAccents(int x, int y, int w, int h, Color c, int len = 16, int thick = 3) {
        // Top-Left
        fillRect(x, y, len, thick, c);
        fillRect(x, y, thick, len, c);
        // Top-Right
        fillRect(x + w - len, y, len, thick, c);
        fillRect(x + w - thick, y, thick, len, c);
        // Bottom-Left
        fillRect(x, y + h - thick, len, thick, c);
        fillRect(x, y + h - len, thick, len, c);
        // Bottom-Right
        fillRect(x + w - len, y + h - thick, len, thick, c);
        fillRect(x + w - thick, y + h - len, thick, len, c);
    }

    void drawCircle(int cx, int cy, int radius, Color c) {
        int r2 = radius * radius;
        for (int dy = -radius; dy <= radius; ++dy) {
            int py = cy + dy;
            if (py < 0 || py >= height) continue;
            for (int dx = -radius; dx <= radius; ++dx) {
                int px = cx + dx;
                if (px < 0 || px >= width) continue;
                if (dx * dx + dy * dy <= r2) {
                    pixels[py * width + px] = c.toARGB();
                }
            }
        }
    }

    void drawEllipse(int cx, int cy, int rx, int ry, Color c, bool bottomHalfOnly = false) {
        float rx2 = static_cast<float>(rx * rx);
        float ry2 = static_cast<float>(ry * ry);
        int startDy = bottomHalfOnly ? 0 : -ry;

        for (int dy = startDy; dy <= ry; ++dy) {
            int py = cy + dy;
            if (py < 0 || py >= height) continue;
            for (int dx = -rx; dx <= rx; ++dx) {
                int px = cx + dx;
                if (px < 0 || px >= width) continue;
                if ((dx * dx) / rx2 + (dy * dy) / ry2 <= 1.0f) {
                    pixels[py * width + px] = c.toARGB();
                }
            }
        }
    }
};

