// ============================================================================
class NativeVoiceEngine {
public:
    NativeVoiceEngine() : m_running(false), m_muted(false) {}
    ~NativeVoiceEngine() { shutdown(); }

    void start() {
        if (m_running) return;
        m_running = true;
        m_worker = std::thread(&NativeVoiceEngine::workerLoop, this);
    }

    void speak(const std::string& text) {
        if (m_muted || !m_running || text.empty()) return;
        {
            std::lock_guard<std::mutex> lock(m_mutex);
            while (m_queue.size() >= 2) m_queue.pop();
            m_queue.push(text);
        }
        m_cv.notify_one();
    }

    void toggleMute() { m_muted = !m_muted; }
    bool isMuted() const { return m_muted; }

    void injectCommand(const std::string& cmd) {
        std::lock_guard<std::mutex> lock(m_cmdMutex);
        m_cmdQueue.push(cmd);
    }

    bool pollCommand(std::string& cmd) {
        std::lock_guard<std::mutex> lock(m_cmdMutex);
        if (m_cmdQueue.empty()) return false;
        cmd = m_cmdQueue.front();
        m_cmdQueue.pop();
        return true;
    }

    void shutdown() {
        if (!m_running) return;
        m_running = false;
        m_cv.notify_all();
        if (m_worker.joinable()) m_worker.join();
    }

private:
    std::atomic<bool> m_running;
    std::atomic<bool> m_muted;
    std::queue<std::string> m_queue;
    std::mutex m_mutex;
    std::condition_variable m_cv;
    std::thread m_worker;

    std::queue<std::string> m_cmdQueue;
    std::mutex m_cmdMutex;

    void workerLoop() {
        CoInitialize(NULL);
        ISpVoice* pVoice = NULL;
        CoCreateInstance(CLSID_SpVoice, NULL, CLSCTX_ALL, IID_ISpVoice, (void**)&pVoice);
        if (pVoice) {
            pVoice->SetRate(1);
            pVoice->SetVolume(90);
        }

        while (m_running) {
            std::string text;
            {
                std::unique_lock<std::mutex> lock(m_mutex);
                m_cv.wait(lock, [this]() { return !m_running || !m_queue.empty(); });
                if (!m_running) break;
                text = m_queue.front();
                m_queue.pop();
            }

            if (m_muted || text.empty()) continue;

            if (pVoice) {
                int len = MultiByteToWideChar(CP_UTF8, 0, text.c_str(), -1, NULL, 0);
                if (len > 0) {
                    std::vector<wchar_t> wstr(len);
                    MultiByteToWideChar(CP_UTF8, 0, text.c_str(), -1, &wstr[0], len);
                    pVoice->Speak(&wstr[0], SPF_DEFAULT, NULL);
                }
            }
        }

        if (pVoice) pVoice->Release();
        CoUninitialize();
    }
};

